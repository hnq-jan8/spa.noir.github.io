{
  "name": "darksite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "postbuild": "rm -rf docs && mv out docs",
    "preview": "rm -rf .preview && mkdir .preview && cp -R docs .preview/spa.noir.github.io && python3 -m http.server ${PORT:-4173} -d .preview",
    "start": "next start"
  },
  "dependencies": {
    "lucide-react": "^1.18.0",
    "next": "^14.2.0",
    "next-intl": "^4.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
